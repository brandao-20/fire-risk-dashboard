# Servidor local
PORT=3001
CACHE_MS=300000

# Fogos.pt
FOGOS_API_URL=https://api.fogos.pt/v2/incidents/active?geojson=true
FOGOS_PT_AUTH=
USER_AGENT=FireRiskPortugalDashboard/1.0 academic-project teu-email@exemplo.com

# NASA FIRMS — obrigatório para hotspots por satélite
NASA_FIRMS_MAP_KEY=coloca_a_tua_map_key_aqui
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT
NASA_FIRMS_DAYS=3

# OpenWeather Fire Weather Index — JSON atual, forecast 5 dias e layer de mapa FWI
# Se receberes 401, a chamada está certa; falta autorização OpenWeather para o produto FWI.
# Nota: além da API key normal, a conta tem de ter acesso autorizado ao produto Fire Weather Index.
OPENWEATHER_API_KEY=coloca_a_tua_api_key_aqui
OPENWEATHER_FWI_POINTS_LIMIT=6
ENABLE_OPENWEATHER_FWI_MAP=false

# Filtro geográfico usado como fallback quando não é escolhido outro no front-end
FIRMS_BBOX=-9.75,36.85,-6.05,42.25

# Camadas Copernicus/EFFIS/GWIS via WMS — opcional, desligado por defeito para não atrasar o mapa.
# Ativa apenas se confirmares que o WMS está acessível na tua rede e que a layer responde corretamente.
ENABLE_COPERNICUS_LAYERS=false
EFFIS_WMS_URL=https://maps.effis.emergency.copernicus.eu/effis
EFFIS_WMS_LAYER=ecmwf007.fwi
